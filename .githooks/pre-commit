#!/usr/bin/env bash
# pre-commit hook: auto-increment the Cargo.toml patch version on every
# commit, unless the version was already changed in this commit.
#
#   ../../0.11.2  →  0.11.3  →  0.11.4  ...
#
# Explicit version bumps (e.g. 0.11.2 -> 0.12.0 for a feature release) are
# left alone because Cargo.toml is staged by then.
#
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

TOML="$(git rev-parse --show-toplevel)/Cargo.toml"

# Doc-only commits (README/AGENTS/docs/*.md/.gitignore) must not bump.
if ! git diff --cached --name-only | grep -vE '\.md$|^docs/|^\.gitignore$' | grep -q .; then
    exit 0
fi

# If Cargo.toml is already staged (version touched by the commit), do nothing.
if ! git diff --cached --quiet -- Cargo.toml; then
    exit 0
fi
if [[ ! -f "$TOML" ]]; then
    exit 0
fi

VER="$(sed -n 's/^version = "\([0-9.]*\)"/\1/p' "$TOML" | head -1)"
if [[ -z "$VER" ]]; then
    exit 0
fi
IFS='.' read -r MAJOR MINOR PATCH <<<"$VER"
NEW="$MAJOR.$MINOR.$((PATCH + 1))"

sed -i "s/^version = \"$VER\"/version = \"$NEW\"/" "$TOML"
git add "$TOML"

# Cargo.lock 记录了本包的版本号, 必须跟着走 —— 否则工作区永远"脏", 发版脚本
# (scripts/release.sh)会以"工作区有未提交改动"为由拒绝发布。
if [ -f "$(git rev-parse --show-toplevel)/Cargo.lock" ] && command -v cargo >/dev/null; then
    ( cd "$(git rev-parse --show-toplevel)" && cargo metadata --format-version 1 >/dev/null 2>&1 || true )
    git add Cargo.lock 2>/dev/null || true
fi
# README 首页写着"当前版本" —— 它也必须在同一次提交里跟着走, 否则
# scripts/check_docs.py 的版本一致性检查会立刻失败(而且很容易被忽略)。
README="$(git rev-parse --show-toplevel)/README.md"
if [ -f "$README" ] && grep -q '| 当前版本 |' "$README"; then
    sed -i "s/| 当前版本 | \*\*[0-9][0-9.]*\*\*/| 当前版本 | **$NEW**/" "$README"
    git add README.md
fi
echo "auto-bump: wal-rust $VER -> $NEW"
